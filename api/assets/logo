<?php
/**
 * api/assets/logo
 * Endpoint para servir classilivre-logo.png com proteção
 * 
 * - Previne download direto (bloqueia right-click, salvar imagem)
 * - Bloqueia hotlinking
 * - Cache controlado
 * - Bloqueia abertura em nova aba
 */

// Bloquear se não tiver referer (acesso direto)
$referer = $_SERVER['HTTP_REFERER'] ?? '';
if (empty($referer)) {
    http_response_code(403);
    header('Content-Type: image/gif');
    // Transparent GIF
    echo base64_decode('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7');
    exit;
}

header('X-Robots-Tag: noindex, nofollow');
header('Cache-Control: public, max-age=3600');
header('Content-Type: image/png');

// Validar referer - apenas do próprio site
$allowed_hosts = [
    'classilivreautos.com',
    'www.classilivreautos.com',
    $_SERVER['HTTP_HOST'] ?? '',
];

$referer_host = parse_url($referer, PHP_URL_HOST);

// Se é de outro domínio, bloquear
if ($referer_host && !in_array($referer_host, $allowed_hosts)) {
    http_response_code(403);
    header('Content-Type: image/gif');
    echo base64_decode('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7');
    exit;
}

// Arquivo de logo
$logo_file = __DIR__ . '/../../assets/img/classilivre-logo.png';

if (!file_exists($logo_file)) {
    http_response_code(404);
    exit;
}

// Headers de proteção contra download
header('Content-Disposition: inline; filename="logo.png"');
header('Content-Length: ' . filesize($logo_file));

// Bloquear cópia via JavaScript/DevTools
header('X-Content-Type-Options: nosniff');
header('X-Frame-Options: SAMEORIGIN');
header('X-XSS-Protection: 1; mode=block');
header('Referrer-Policy: strict-origin-when-cross-origin');

// Servir arquivo
readfile($logo_file);
